generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model users {
    userId   Int     @id @default(autoincrement()) @map("user_id")
    email    String  @unique
    name     String? @map("full_name") @db.VarChar(255)
    password String

    createdAt DateTime @default(now()) @map("created_at") @db.Timestamp

    userDetails userDetails? @relation("user_details")
}

model role {
    roleId Int    @id @default(autoincrement()) @map("role_id")
    name   String @unique

    userDetails userDetails[] @relation("user_details_role")
}

model userDetails {
    referenceId    Int     @id @map("reference_id")
    batch          Int
    department     String?
    contact_number String?

    position         String?
    enrollmentNumber BigInt? @unique @map("enrollment_number")

    roleId    Int   @map("role_id")
    courseIds Int[] @map("course_ids")
    teamIds   Int[] @map("team_ids")

    role         role    @relation("user_details_role", fields: [roleId], references: [roleId], map: "role_id_key")
    user         users   @relation("user_details", fields: [referenceId], references: [userId], map: "user_id_key")
    eventManager event[] @relation("event_manager")

    @@map("user_details")
}

model team {
    name String @id @map("team_id")
    eventIds String[] @map("event_ids")
}

model course {
    courseId   Int    @id @default(autoincrement()) @map("course_id")
    name       String
    code       String @unique
    credits    Int
    semester   Int
    department String
}

model event {
    eventId     Int      @id @default(autoincrement()) @map("event_id")
    name        String
    description String
    startDate   DateTime @map("start_date")
    endDate     DateTime @map("end_date")
    organizer   String
    status      String
    managerId   Int      @map("manager_id")
    teamIds     Int[]    @map("team_ids")

    user      userDetails @relation("event_manager", fields: [managerId], references: [referenceId], map: "event_manager_id")
    eventTeam eventTeam[] @relation("event_relation")
}

model eventTeam {
    eventId Int @map("event_id")
    teamId  Int @map("team_id")

    event event @relation("event_relation", fields: [eventId], references: [eventId], map: "event_id_key")
    // team  team  @relation("team_relation", fields: [teamId], references: [teamId], map: "team_id_key")

    @@id([eventId, teamId])
    @@map("event_teams")
}